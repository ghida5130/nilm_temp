# Syntax-check examples only. Jenkins replaces these with pushed image digests.
API_GATEWAY_IMAGE=docker.io/leejeongmin24/on-maum:api-gateway-example
IOT_DEVICE_IMAGE=docker.io/leejeongmin24/on-maum:iot-device-service-example
MONITORING_IMAGE=docker.io/leejeongmin24/on-maum:monitoring-service-example
FRONTEND_IMAGE=docker.io/leejeongmin24/on-maum:frontend-example

POSTGRES_HOST=10.0.2.20
POSTGRES_USER=nilm_admin
POSTGRES_PASSWORD=replace-with-db-password

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=replace-with-admin-password
KEYCLOAK_HOSTNAME=https://auth.example.com
JWT_ISSUER_URI=https://auth.example.com/realms/nilm

FRONTEND_ORIGIN=https://nilm.example.com
CORS_ALLOWED_ORIGINS=https://nilm.example.com

NILM_SMOKE_CLIENT_SECRET=replace-with-random-secret

APP_DOMAIN=nilm.example.com
AUTH_DOMAIN=auth.example.com
# Set by Jenkins: /opt/nilm. For offline validation: this folder.
CONFIG_ROOT=.
