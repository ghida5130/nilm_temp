# Syntax-check examples only. Jenkins replaces these with pushed image digests.
MQTT_KAFKA_BRIDGE_IMAGE=docker.io/leejeongmin24/on-maum:mqtt-kafka-bridge-example
REALTIME_ANALYSIS_IMAGE=docker.io/leejeongmin24/on-maum:realtime-analysis-service-example
AGGREGATION_IMAGE=docker.io/leejeongmin24/on-maum:aggregation-service-example
EC2_B_PRIVATE_IP=10.0.2.20
POSTGRES_USER=nilm_admin
POSTGRES_PASSWORD=replace-with-db-password

KAFKA_RAW_TOPIC=power.raw.v1
KAFKA_ANALYSIS_EVENT_TOPIC=analysis.event.v1
KAFKA_ANALYSIS_ACTIVITY_TOPIC=analysis.activity.v1
KAFKA_ANALYSIS_DATA_QUALITY_TOPIC=analysis.data-quality.v1
KAFKA_ANALYSIS_SNAPSHOT_TOPIC=analysis.snapshot.v1
KAFKA_ANALYSIS_DLQ_TOPIC=dlq.analysis
KAFKA_MONITORING_DLQ_TOPIC=dlq.monitoring
KAFKA_PARTITIONS=24

ANALYSIS_KAFKA_GROUP_ID=realtime-analysis-service-v1
ANALYSIS_KAFKA_AUTO_OFFSET_RESET=latest
ANALYSIS_MODEL_WINDOW_SIZE=299
ANALYSIS_FAKE_ON_APPLIANCES=
ANALYSIS_SCORE_THRESHOLD=80
ANALYSIS_TIMEZONE=Asia/Seoul
ANALYSIS_EXPECTED_SAMPLES_PER_DAY=86400
ANALYSIS_OBSERVATION_VALID_COVERAGE_RATIO=0.95
ROUTINE_BASELINE_REFRESH_SECONDS=60
ANALYSIS_LOG_LEVEL=INFO

# DNS name must match the Mosquitto server certificate's SAN.
MQTT_HOST=mqtt.internal.example.com
MQTT_PORT=8883
MQTT_USER=kafka_bridge_user
MQTT_PASS=replace-with-bridge-password
MQTT_CA_FILE=/etc/mqtt/ca.crt
CONFIG_ROOT=.
